{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev-bee",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx",
        "scripts/dev-bee.ts",
        "7788"
      ],
      "port": 7788
    },
    {
      "name": "dev-engine",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev-engine.mjs"
      ],
      "port": 7790
    },
    {
      "name": "dev-creator",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dist/cli.js",
        "coordinator",
        "--public",
        "--port",
        "7799",
        "--data",
        "data/dev-creator",
        "--owner-code",
        "local-dev-owner-code-only"
      ],
      "port": 7799
    },
    {
      "name": "dev-bee-live",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx",
        "scripts/dev-bee.ts",
        "7788",
        "--animate"
      ],
      "port": 7788
    }
  ]
}
